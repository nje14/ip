<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.shape.Rectangle?>

<fx:root alignment="CENTER_RIGHT"
         fillHeight="true"
         maxWidth="1.7976931348623157E308"
         prefWidth="400.0"
         spacing="8.0"
         stylesheets="@../css/dialog-box.css"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/25"
         xmlns:fx="http://javafx.com/fxml/1">

    <children>
        <Label fx:id="dialog"
               minHeight = "-Infinity"
               maxWidth="1.7976931348623157E308"
               styleClass="dialog-label"
               text="Label"
               wrapText="true"
               HBox.hgrow="ALWAYS">
            <padding>
                <Insets bottom="8.0"
                        left="10.0"
                        right="10.0"
                        top="8.0"/>
            </padding>
        </Label>

        <ImageView fx:id="displayPicture"
                   fitHeight="70.0"
                   fitWidth="70.0"
                   preserveRatio="true"
                   smooth="true">
            <clip>
                <Rectangle arcHeight="18.0"
                           arcWidth="18.0"
                           height="70.0"
                           width="70.0"/>
            </clip>
        </ImageView>
    </children>

    <padding>
        <Insets bottom="8.0"
                left="8.0"
                right="8.0"
                top="8.0"/>
    </padding>
</fx:root>
